TUTOR_PUBLIC=1
TUTOR_SECURE=1
TUTOR_HOST=0.0.0.0
TUTOR_PORT=8787
TUTOR_DB=/data/tutor.sqlite
TUTOR_UPLOADS=/data/uploads
TUTOR_ORIGIN=https://tutor.example.com
# Generate once: openssl rand -base64 32. Keep the same secret for backups/restores.
TUTOR_ENCRYPTION_KEY=
# Parent verification and recovery. Choose smtp or resend.
TUTOR_MAIL_PROVIDER=smtp
# SMTP configuration (not required when using resend):
TUTOR_SMTP_URL=smtps://username:password@smtp.example.com:465
TUTOR_MAIL_FROM=Tutor <hello@example.com>
# For Resend: set TUTOR_MAIL_PROVIDER=resend and supply its private API key.
RESEND_API_KEY=
