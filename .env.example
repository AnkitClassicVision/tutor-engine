# Bubble · Tutor Engine settings. Copy what you need into your host's environment (Vercel: Project → Settings →
# Environment Variables). Never commit real values. Local development needs none of these.

# ---- Public deployment (required) ----
TUTOR_PUBLIC=1
TUTOR_SECURE=1
# The https address people use, without a trailing slash. Email links and OAuth callbacks return here.
TUTOR_ORIGIN=https://tutor.example.org

# ---- Encryption (required in public mode) ----
# 32 random bytes, base64: openssl rand -base64 32
# Protects AI keys and every family's data key. Store a copy in a password manager: without it, families'
# AI connections and encrypted data cannot be opened.
TUTOR_ENCRYPTION_KEY=
# While rotating, the old key(s), comma-separated; then run scripts/rotate-encryption-key.ts and remove them.
TUTOR_ENCRYPTION_KEYS_PREVIOUS=
# Seals backup files made with scripts/cloud-backup.ts. Generate separately and keep it apart from the key above.
TUTOR_BACKUP_KEY=

# ---- Storage: Vercel + Neon + Blob ----
TUTOR_CLOUD=1
TUTOR_STORAGE=blob
# Set by the Neon integration. The pooled URL serves requests; the direct (unpooled) URL runs migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional, recommended: a data-only database role for requests and jobs (scripts/create-app-role.ts sets it).
TUTOR_APP_DATABASE_URL=
# Set by connecting a private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Protects the weekly digest cron route. Any long random string.
CRON_SECRET=

# ---- Storage: single host with SQLite (Docker/Compose or a plain server) ----
# TUTOR_DB=/data/tutor.sqlite
# TUTOR_UPLOADS=/data/uploads
# TUTOR_HOST=0.0.0.0
# TUTOR_PORT=8787

# ---- Email (required in public mode: verification and password recovery) ----
TUTOR_MAIL_PROVIDER=resend
TUTOR_MAIL_FROM=Tutor <tutor@mail.example.org>
RESEND_API_KEY=
# Or: TUTOR_MAIL_PROVIDER=smtp and
# TUTOR_SMTP_URL=smtps://username:password@smtp.example.org:465

# ---- Who runs this site (shown on /privacy and /terms) ----
TUTOR_OPERATOR_NAME=
TUTOR_CONTACT_EMAIL=
# Your fork's source code, if you changed the code (AGPL-3.0 section 13).
TUTOR_SOURCE_URL=

# ---- Optional: ChatGPT plan sign-in (needs a client registered with OpenAI) ----
# TUTOR_CHATGPT_CLIENT_ID=
# TUTOR_CHATGPT_CLIENT_SECRET=
